# Ключ Groq: https://console.groq.com/keys (бесплатный тариф)
GROQ_API_KEY=gsk_замени_на_свой_ключ

# Модель Groq. Список: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Порт бэкенда (фронт проксирует /api сюда)
PORT=3001

# Путь к файлу SQLite относительно корня репозитория
DB_PATH=data/app.db
